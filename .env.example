# Copy to .env.local for `next dev`. Production values go in the Vercel dashboard.

# Upstash Redis (Vercel Storage / Marketplace). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Same random string on both. Public token is baked into the client at build time.
PAYMENTS_HOUSEHOLD_TOKEN=
NEXT_PUBLIC_PAYMENTS_TOKEN=
